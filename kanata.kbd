(defalias
  ml (layer-while-held ml)
  mr (layer-while-held mr)
  mv (layer-while-held mv)

  ma↑ (movemouse-accel-up    1 1000 1 5)
  ma← (movemouse-accel-left  1 1000 1 5)
  ma↓ (movemouse-accel-down  1 1000 1 5)
  ma→ (movemouse-accel-right 1 1000 1 5)

  sh_dance (tap-dance 222 (
             (caps-word 4000)
             (one-shot-release 500 lsft)
             
              ))
  shp (tap-dance 222 (
              (one-shot 2000 lsft)
              (caps-word 4000)
              ))
)


